PREFIX :     <http://definities.geostandaarden.nl/nen3610-2022/id/begrip/>
PREFIX bk:   <http://definities.geostandaarden.nl/nen3610-2022/id/begrippenkader/>
PREFIX col:  <http://definities.geostandaarden.nl/nen3610-2022/id/collectie/>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX iso:  <http://isotc211.geolexica.org/concepts/>
PREFIX ogc:  <http://defs.opengis.net/vocprez/object?uri=http%3A//www.opengis.net/def/function/geosparql/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

col:basisinformatie-elementen
        a                skos:Collection;
        dct:source       "NEN3610:2022 Basismodel Geo-informatie - 8.2.1"@nl;
        skos:definition  ""@nl;
        skos:member      :begin_geldigheid , :domein , :eind_geldigheid , :eind_registratie , :geo-object , :identificatie , :object_begintijd , :object_eindtijd , :tijdstip_registratie , :versie;
        skos:prefLabel   "Basisinformatie-elementen"@nl;
        skos:scopeNote   "Elementen die een cruciale rol spelen in NEN 3610. Dit zijn het objectype Geo-object, de attributen ter identificatie van objecten en het objectype Registratiegegevens met de attributen voor de implementatie van het temporele model."@nl .

:begin_geldigheid  a       skos:Concept;
        dct:source         "NEN3610:2022 Basismodel Geo-informatie - 8.3.2"@nl;
        skos:definition    "Start van de periode waarop deze versie van het informatieobject geldig is."@nl;
        skos:hiddenLabel   "beginGeldigheid"@nl , "begingeldigheid"@nl;
        skos:inScheme      bk:nen3610-2022;
        skos:prefLabel     "Begin geldigheid"@nl;
        skos:scopeNote     "Er zijn verschillende datatypen voor de representatie van een tijdsaanduiding: afhankelijk van de gebruikerswensen m.b.t. granulariteit kan o.a. worden gekozen uit typen: TM_instand, Date of DateTime. De start van een periode is het begin van de tijdsaanduiding; het 'vanaf-moment'. Bij een datum (Date) is dat het begin van die dag."@nl;
        skos:topConceptOf  bk:nen3610-2022 .

:domein  a                 skos:Concept;
        dct:source         "NEN3610:2022 Basismodel Geo-informatie - 8.2.5"@nl;
        skos:definition    "Aanduiding van het domein waarbinnen de identificatie uniek is."@nl;
        skos:inScheme      bk:nen3610-2022;
        skos:prefLabel     "Domein (attribuut)"@nl;
        skos:topConceptOf  bk:nen3610-2022 .

:eind_geldigheid  a         skos:Concept;
        dct:source          "NEN3610:2022 Basismodel Geo-informatie - 8.3.2"@nl;
        skos:definition     "Eind van de periode waarop deze versie van het informatieobject geldig is in de werkelijkheid."@nl;
        skos:editorialNote  "Wanneer deze waarde niet is ingevuld is de versie nog geldig."@nl;
        skos:hiddenLabel    "eindGeldigheid"@nl , "eindgeldigheid"@nl;
        skos:inScheme       bk:nen3610-2022;
        skos:prefLabel      "Eind geldigheid"@nl;
        skos:related        :tijdlijn_geldigheid;
        skos:topConceptOf   bk:nen3610-2022 .

:eind_registratie  a        skos:Concept;
        rdfs:label          "Eind registratie"@nl;
        dct:source          "NEN3610:2022 Basismodel Geo-informatie - 8.3.3"@nl;
        skos:definition     "Eind van de periode dat deze versie van het informatieobject geldig is in de registratie."@nl;
        skos:editorialNote  "De periode is tot aan deze tijdsaanduiding. Wanneer deze waarde niet is ingevuld, is de versie nog actueel."@nl;
        skos:hiddenLabel    "eindRegistratie"@nl , "eindregistratie"@nl;
        skos:inScheme       bk:nen3610-2022;
        skos:prefLabel      "Eind registratie"@nl;
        skos:related        :tijdlijn_registratie;
        skos:topConceptOf   bk:nen3610-2022 .

:geo-object  a              skos:Concept;
        rdfs:label          "Geo-object"@nl , "Geographic feature"@en;
        dct:source          "NEN3610:2022 Basismodel Geo-informatie - 8.4.4"@nl;
        skos:definition     "Een fenomeen in de werkelijkheid dat direct of indirect is geassocieerd met een locatie relatief ten opzichte van de aarde."@nl;
        skos:editorialNote  "Bij deze definitie is het van belang om te beseffen dat de associatie met een locatie een informatiecomponent is die van het feonomeen een geo-object maakt. Het gaat erom dat de locatie is opgenomen bij het objecttype en dus wordt geregistreeerd. Hetzelfde fenomeen kan ook voorkomen zonder dat er een associatie met een locatie is en de locatie dus niet wordt geregistreeerd. In dat geval is het geen geo-object, maar een algemeen object."@nl , "Een directe associatie met een locatie is via coördinaten, een indirecte via een geografische identificator, bijvoorbeeld een adres of postcode."@nl , "Of een fenomeen een geo-object is of niet hangt af van de context waarin het object is geplaatst. Is er een associatie met een geogerefereerde locatie, dan is het een geo-object. Is de associatie er niet, dan is het fenomeen geen geo-object. Zo is bijvoorbeeld het fenomeen huis weergegeven op een landkaart een geo-object. Is het weergegeven op een foto dan is het geen geo-object. Met andere woorden: het vastleggen van logisch_informatie maakt van een object een geo-object."@nl , "W3C hanteert de term 'ruimtelijk ding'('spatial thing') en bedoelt daarmee zowel het fenomeen in de werkelijkheid als zijn abstractie."@nl;
        skos:exactMatch     iso:203;
        skos:inScheme       bk:nen3610-2022;
        skos:narrower       :reeel_object , :virtuele_ruimte;
        skos:prefLabel      "Geo-object"@nl;
        skos:scopeNote      "Een geo-object heeft een geografische dimensie die als eigenschap wordt geregistreerd."@nl;
        skos:topConceptOf   bk:nen3610-2022 .

:identificatie  a           skos:Concept;
        dct:source          "NEN3610:2022 Basismodel Geo-informatie - 8.2.5"@nl;
        skos:definition     "Unieke identificatiecode van een informatieobject binnen de context van een registratie."@nl;
        skos:editorialNote  "Alleen de volgende karakters mogen in een waarde van het attribuut identificatie voorkomen: {'A' ... 'Z', 'a' ... 'z', '0' ... '9', '_', '-', ',', '.', '/', ':'}"@nl;
        skos:inScheme       bk:nen3610-2022;
        skos:prefLabel      "Identificatie"@nl;
        skos:scopeNote      "Identificatie is de identificatiecode die een object heeft binnen een registratie of binnen een ketenproces voor data-uitwisseling. Binnen de registratie of de data-uitwisseling is het object uniek identificeerbaar. In combinatie met het attribuut domein wordt een object hiermee uniek identificeerbaar op het niveau van verschillende registraties, uitwisselprocessen en ook wereldwijd uniek."@nl;
        skos:topConceptOf   bk:nen3610-2022 .

:object_begintijd  a       skos:Concept;
        dct:source         "NEN3610:2022 Basismodel Geo-informatie - 8.3.4"@nl;
        skos:definition    "Tijdsaanduiding waarop het object in de werkelijkheid is ontstaan."@nl;
        skos:inScheme      bk:nen3610-2022;
        skos:prefLabel     "Object begintijd"@nl;
        skos:related       :levensduur;
        skos:scopeNote     "Er zijn verschillende datatypen voor de representatie van een tijdsaanduiding: afhankelijk van de gebruikerswensen m.b.t. granulariteit kan o.a. worden gekozen uit typen TM_Instand, Date of DateTime"@nl;
        skos:topConceptOf  bk:nen3610-2022 .

:object_eindtijd  a        skos:Concept;
        dct:source         "NEN3610:2022 Basismodel Geo-informatie - 8.3.4"@nl;
        skos:definition    "Tijdsaanduiding waarop het object in de werkelijkheid niet meer geldig is."@nl;
        skos:inScheme      bk:nen3610-2022;
        skos:prefLabel     "Object eindtijd"@nl;
        skos:related       :levensduur;
        skos:scopeNote     "Er zijn verschillende datatypen voor de representatie van een tijdsaanduiding: afhankelijk van de gebruikerswensen m.b.t. granulariteit kan o.a. worden gekozen uit typen TM_Instand, Date of DateTime."@nl;
        skos:topConceptOf  bk:nen3610-2022 .

:tijdstip_registratie
        a                  skos:Concept;
        rdfs:label         "Tijdstip registratie"@nl;
        dct:source         "NEN3610:2022 Basismodel Geo-informatie - 8.3.3"@nl;
        skos:definition    "Tijdstip waarop deze versie van het informatieobject is opgenomen in de registratie."@nl;
        skos:hiddenLabel   "tijdstipRegistratie"@nl , "tijdstipregistratie"@nl;
        skos:inScheme      bk:nen3610-2022;
        skos:prefLabel     "Tijdstip registratie"@nl;
        skos:related       :tijdlijn_registratie;
        skos:topConceptOf  bk:nen3610-2022 .

:versie  a                 skos:Concept;
        dct:source         "NEN3610:2022 Basismodel Geo-informatie - 8.2.5"@nl;
        skos:definition    "De versie-aanduiding van een object."@nl;
        skos:inScheme      bk:nen3610-2022;
        skos:prefLabel     "Versie"@nl;
        skos:topConceptOf  bk:nen3610-2022 .

bk:nen3610-2022  a          skos:ConceptScheme;
        skos:hasTopConcept  :begin_geldigheid , :domein , :eind_geldigheid , :eind_registratie , :geo-object , :identificatie , :object_begintijd , :object_eindtijd , :tijdstip_registratie , :versie , :tijdlijn_geldigheid , :tijdlijn_registratie , :levensduur , :mogelijk_geen_waarde , :bevat , :binnen , :disjunct , :doorsnijdt , :gelijk , :kruist , :overlapt , :raakt , :beschouwingsgebied , :dataproduct , :georeferentie , :informatieobject , :interoperabiliteit , :model , :object , :objectcatalogus , :objectregistratie , :registratiegegevens , :registratiehouder , :representatie , :sector , :symbool , :vorig_geldige_versie , :vorig_geregistreerde_versie , :data , :dataspecificatie , :datatype , :dataset , :datasetserie , :applicatieschema , :metadata , :attribuut , :coordinaat , :geografische_identificatie , :geo_informatie , :presentatie , :ruimtelijk_referentiesysteem , :informatiemodel , :coordinaatreferentiesysteem , :geodetische_datum , :coordinaatsysteem , :attribuutwaarde , :conceptueel_informatiemodel , :gegeven , :logisch_informatiemodel , :registratie;
        skos:prefLabel      "Begrippenkader NEN3610:2022"@nl .

:tijdlijn_geldigheid  a     skos:Concept;
        rdfs:label          "Tijdlijn geldigheid";
        dct:source          "NEN3610:2022 Basismodel Geo-informatie - 8.3.2"@nl;
        skos:definition     "Typering dat dit attribuut wordt gebruikt voor het beschrijven van de geldigheidsperiode van de gegevens."@nl;
        skos:editorialNote  "Dit is het begrip 'tijdlijn_geldigheid' en heeft daarom een andere definitie dan de collectie 'tijdlijn_geldigheid'"@nl;
        skos:hiddenLabel    "TijdlijnGeldigheid"@nl;
        skos:inScheme       bk:nen3610-2022;
        skos:prefLabel      "Tijdlijn geldigheid"@nl;
        skos:related        :eind_geldigheid;
        skos:scopeNote      "Tijdlijn geldigheid benoemt periodes waarop een informatieobject, oftewel de functionele gegevens die worden bijgehouden over de eigenschappen van een object, een geldige (correcte) representatie zijn van de werklijkheid. TijdlijnGeldigheid wordt geïmplementeerd door de attributen: beginGeldigheid en eindGeldigheid."@nl;
        skos:topConceptOf   bk:nen3610-2022 .

:tijdlijn_registratie
        a                   skos:Concept;
        rdfs:label          "Tijdlijn registratie";
        dct:source          "NEN3610:2022 Basismodel Geo-informatie - 8.3.3"@nl;
        skos:altLabel       "Tijdlijn Registratie"@nl;
        skos:definition     "Typering dat dit attribuut wordt gebruikt voor historie van veranderingen van gegevens van een informatieobject in de registratie."@nl;
        skos:editorialNote  "Dit is het begrip 'tijdlijn_registratie' en heeft daarom een andere definitie dan de collectie 'tijdlijn_registratie'"@nl;
        skos:hiddenLabel    "TijdlijnRegistratie"@nl;
        skos:inScheme       bk:nen3610-2022;
        skos:prefLabel      "Tijdlijn registratie"@nl;
        skos:related        :eind_registratie , :tijdstip_registratie;
        skos:scopeNote      "TijdlijnRegistratie wordt geïmplementeerd door de attributen: tijdstipRegistratie en eindRegistratie."@nl;
        skos:topConceptOf   bk:nen3610-2022 .

:reeel_object  a         skos:Concept;
        rdfs:label       "Reëel object"@nl;
        dct:source       "NEN3610:2022 Basismodel Geo-informatie - 8.4.4"@nl;
        skos:altLabel    "Fysiek object"@nl;
        skos:broader     :geo-object;
        skos:definition  "Geo-object dat zich geheel materieel manifesteert."@nl;
        skos:inScheme    bk:nen3610-2022;
        skos:narrower    :begroeiing , :bodem , :constructie , :oppervlaktewater;
        skos:prefLabel   "Reëel object"@nl;
        skos:scopeNote   "Een reëel of fysiek object is een tastbaar begrensd object dat gekenmerkt wordt door zijn materiele samenstelling en structuur."@nl .

:virtuele_ruimte  a      skos:Concept;
        rdfs:label       "Virtuele ruimte"@nl;
        dct:source       "NEN3610:2022 Basismodel Geo-informatie - 8.4.4"@nl;
        skos:broader     :geo-object;
        skos:definition  "Geo-object dat zich geheel of gedeeltelijk niet-materieel manifesteert en dus slechts in abstracte en/of geregistreerde vorm bestaat."@nl;
        skos:example     "Objecten voor bestuurlijke grenzen, eigendomsbegrenzing, beheerbegrenzingen, ruimtelijk beleid"@nl;
        skos:inScheme    bk:nen3610-2022;
        skos:narrower    :functionele_ruimte , :geografische_ruimte , :juridische_ruimte , :registratieve_ruimte;
        skos:prefLabel   "Virtuele ruimte"@nl;
        skos:scopeNote   "Virtuele ruimten bevatten geo-objecten waarvan de begrenzing of een gedeelte van de begrenzing niet tastbaar en dus ook niet zichtbaar aanwezig is. Het betreft veelal het administratief of wettelijk benoemen en vastleggen van ruimten."@nl .

iso:203  skos:exactMatch  :geo-object .

:levensduur  a              skos:Concept;
        rdfs:label          "Levensduur";
        dct:source          "NEN3610:2022 Basismodel Geo-informatie - 8.3.4"@nl;
        skos:definition     "Typering dat dit attribuut wordt gebruikt voor de Vastlegging van het tijdsinterval waarin dit informatieobject de werkelijkheid representeert."@nl;
        skos:editorialNote  "Dit is het begrip 'levensduur' en heeft daarom een andere definitie dan de collectie 'levensduur'"@nl;
        skos:inScheme       bk:nen3610-2022;
        skos:prefLabel      "Levensduur"@nl;
        skos:related        :object_begintijd , :object_eindtijd;
        skos:scopeNote      "Levensduur wordt vastgelegd door de attributen: objectBegintijd en obejctEindtijd."@nl;
        skos:topConceptOf   bk:nen3610-2022 .

:mogelijk_geen_waarde
        a                  skos:Concept;
        rdfs:label         "Mogelijk geen waarde"@nl;
        dct:source         "NEN3610:2022 Basismodel Geo-informatie - 9.8"@nl;
        skos:definition    "Metagegeven dat aangeeeft dat een warde niet bekend is of dat een ontvanger niet geautoriseerd is om de waarde te ontvangen."@nl;
        skos:hiddenLabel   "mogelijkGeenWaarde"@nl;
        skos:inScheme      bk:nen3610-2022;
        skos:narrower      :geen_waarde , :niet_geautoriseerd , :niet_ondersteund , :vastgesteld_onbekend , :waarde_onbekend;
        skos:prefLabel     "Mogelijk geen waarde"@nl;
        skos:scopeNote     "Bij mogelijk geen waarde = 'ja' hoort ook de mogelijkheid om de reden voor het niet uitwisselen of niet opnemen in de registratie te delen. Het gebruik hiervan is optioneel. Het is dus op het niveau van NEN 3610 niet verplicht om een reden op te nemen. Een sectoraal model kan hier nadere afspraken over maken. De redenen voor het niet delen van informatie zijn opgenomen in de lijst VoidReasonValue. Deze lijst is uitbreidbaar, waardoor ook andere redenen opgenomen kunnen worden."@nl , "Er zijn situaties dat de waarde van een attribuut om redenen niet wordt gedeeld of soms ook niet in een registraties is opgeslagen. Met het metagegeven mogelijk geen waarde = 'ja', wordt aangegeven of deze conditite is toegestaan. In dat geval mag deze eigenschap bij uitwisseling een 'nil'-waarde bevatten. Dit betekent dat het attribuut geen waarde heeft in deze dataset, maar at het object in de werkelijkheid wel een waarde kan hebben."@nl , "Het metagegeven mogelijk geen waarde = 'ja' wordt alleen toegepast op de attributen waarvan gewenst wordt dat deze mogelijkheid er is. Het kan zowel op verplichte attributen als op optionele attributen worden toegepast."@nl;
        skos:topConceptOf  bk:nen3610-2022 .

